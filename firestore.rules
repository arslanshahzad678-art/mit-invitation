rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin role check: matches owner email arslanshahzad678@gmail.com or registered admin doc
    function isAuthorizedAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'arslanshahzad678@gmail.com' && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'password')) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Schema Validation Helpers
    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.slug is string && data.slug.size() <= 200 &&
             data.regularPrice is number && data.regularPrice >= 0 &&
             data.status in ['published', 'draft'];
    }

    function isValidCategory(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.slug is string && data.slug.size() <= 100;
    }

    function isValidSection(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.type is string && data.type.size() <= 50 &&
             data.title is string && data.title.size() <= 200 &&
             data.isVisible is bool &&
             data.order is number;
    }

    function isValidReview(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.authorName is string && data.authorName.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.text is string && data.text.size() <= 2000;
    }

    function isValidFAQ(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.question is string && data.question.size() <= 500 &&
             data.answer is string && data.answer.size() <= 5000;
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.orderNumber is string && data.orderNumber.size() <= 50 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 150 &&
             data.customerEmail is string && data.customerEmail.size() <= 254 &&
             data.customerPhone is string && data.customerPhone.size() <= 50 &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.status in ['new', 'confirmed', 'in_progress', 'completed', 'cancelled'];
    }

    function isValidDesignSettings(data) {
      return data.brandName is string && data.brandName.size() > 0 && data.brandName.size() <= 100;
    }

    function isValidStoreSettings(data) {
      return data.whatsAppNumber is string && data.whatsAppNumber.size() <= 50 &&
             data.phone is string && data.phone.size() <= 50 &&
             data.email is string && data.email.size() <= 254;
    }

    // 1. Products Collection
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isValidId(productId) && isAuthorizedAdmin() && isValidProduct(incoming());
      allow update: if isValidId(productId) && isAuthorizedAdmin() && isValidProduct(incoming());
      allow delete: if isValidId(productId) && isAuthorizedAdmin();
    }

    // 2. Categories Collection
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create: if isValidId(categoryId) && isAuthorizedAdmin() && isValidCategory(incoming());
      allow update: if isValidId(categoryId) && isAuthorizedAdmin() && isValidCategory(incoming());
      allow delete: if isValidId(categoryId) && isAuthorizedAdmin();
    }

    // 3. Page Sections Collection
    match /sections/{sectionId} {
      allow get, list: if true;
      allow create: if isValidId(sectionId) && isAuthorizedAdmin() && isValidSection(incoming());
      allow update: if isValidId(sectionId) && isAuthorizedAdmin() && isValidSection(incoming());
      allow delete: if isValidId(sectionId) && isAuthorizedAdmin();
    }

    // 4. Reviews Collection
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isValidId(reviewId) && isAuthorizedAdmin() && isValidReview(incoming());
      allow update: if isValidId(reviewId) && isAuthorizedAdmin() && isValidReview(incoming());
      allow delete: if isValidId(reviewId) && isAuthorizedAdmin();
    }

    // 5. FAQs Collection
    match /faqs/{faqId} {
      allow get, list: if true;
      allow create: if isValidId(faqId) && isAuthorizedAdmin() && isValidFAQ(incoming());
      allow update: if isValidId(faqId) && isAuthorizedAdmin() && isValidFAQ(incoming());
      allow delete: if isValidId(faqId) && isAuthorizedAdmin();
    }

    // 6. Settings Collection (design, store)
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update: if isAuthorizedAdmin() && (
        (settingId == 'design' && isValidDesignSettings(incoming())) ||
        (settingId == 'store' && isValidStoreSettings(incoming())) ||
        isAuthorizedAdmin()
      );
      allow delete: if isAuthorizedAdmin();
    }

    // 7. Orders Collection (Customer PII is strictly protected)
    match /orders/{orderId} {
      // Public visitors can only create new orders with status 'new'
      allow create: if isValidId(orderId) && isValidOrder(incoming()) && incoming().status == 'new';
      // Only authorized admin can view customer details, update status, or delete orders
      allow get, list: if isAuthorizedAdmin();
      allow update, delete: if isAuthorizedAdmin();
    }

    // 8. Admins Collection
    match /admins/{adminId} {
      allow read, write: if isAuthorizedAdmin();
    }

    // 9. Templates Collection (Admin Canva Builder & Public Read)
    match /templates/{templateId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorizedAdmin();
    }

    // 10. Slugs Collection (For vanity invitation links)
    match /invitationSlugs/{slug} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isAuthorizedAdmin();
    }

    // 11. Invitations Collection
    match /invitations/{invitationId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAuthorizedAdmin();

      // Guest RSVPs Subcollection (Guests submit responses, host and admin view)
      match /guests/{guestId} {
        allow get, list: if true;
        allow create, update: if true;
        allow delete: if isAuthorizedAdmin() || isSignedIn();
      }
    }

    // 12. Admin Log
    match /adminLog/{logId} {
      allow create: if true;
      allow read, update, delete: if isAuthorizedAdmin();
    }
  }
}
